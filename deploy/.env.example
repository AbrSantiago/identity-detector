# Copiá este archivo a deploy/.env y ajustá los valores.
# El backend lee estas variables al iniciar (backend/app/config.py).

# Orígenes exactos permitidos por CORS (separados por coma, sin barra final).
# En local, con los frontends servidos por run_local.py:
ALLOWED_ORIGINS=http://chat.localhost:8000,http://detector.localhost:8000
# En producción, por ejemplo:
# ALLOWED_ORIGINS=https://chat.tudominio.ar,https://detector.tudominio.ar

# IPs (o redes CIDR) de proxies en los que confiamos para leer X-Forwarded-For.
# Vacío en local (conexión directa). Detrás de Cloudflare/Caddy, poné la IP del
# proxy. Si queda vacío con un proxy delante, verás siempre la IP del proxy.
TRUSTED_PROXIES=

# Horas que viven los datos en memoria antes del barrido por TTL.
DATA_TTL_HOURS=6

# Umbral mínimo de puntaje (0..1) para afirmar "te reconozco".
MATCH_THRESHOLD=0.35

# Tope de mensajes de chat guardados en memoria.
CHAT_HISTORY_LIMIT=200

# Tope de eventos de match guardados para el historial en vivo.
MATCH_HISTORY_LIMIT=500
