# Copiá a deploy/.env y ajustá lo que necesites. `docker compose` (corrido desde
# deploy/) lo lee solo. Para Dev Tunnels NO hace falta tocar nada: los defaults
# del compose ya aceptan *.devtunnels.ms y el frontend deriva la URL del backend.

# --- Frontends ---
# URL del backend que usan el chat y el detector. Vacío => el frontend la deriva
# del host actual (Dev Tunnels / localhost). Con dominio propio, fijala:
# API_BASE=https://api.tudominio.ar
API_BASE=

# --- CORS ---
# Regex de orígenes permitidos (además de ALLOWED_ORIGINS). El default del
# compose ya trae el de Dev Tunnels: https://.*\.devtunnels\.ms$
# ALLOWED_ORIGIN_REGEX=https://.*\.devtunnels\.ms$
#
# Orígenes exactos (coma, sin barra final). Con dominio propio:
# ALLOWED_ORIGINS=https://chat.tudominio.ar,https://detector.tudominio.ar
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# --- Red / privacidad ---
# IPs o redes CIDR de proxies de confianza para leer X-Forwarded-For. Vacío en
# conexión directa (Dev Tunnels termina el TLS afuera; si querés la IP real del
# visitante detrás del túnel, es un límite conocido y queda documentado).
TRUSTED_PROXIES=

# Horas que viven los datos en memoria antes del barrido por TTL.
DATA_TTL_HOURS=6

# Umbral mínimo de puntaje (0..1) para afirmar "te reconozco".
MATCH_THRESHOLD=0.35

# Topes en memoria.
CHAT_HISTORY_LIMIT=200
MATCH_HISTORY_LIMIT=500
